# Environment & secrets
.env
.env.*
*.env
!.env.example
# Template for the backend-only secret split (docker-compose.yml). The real
# `.env.backend-secrets` stays ignored by the `.env.*` rule above — only the
# empty-valued example is tracked. Without this negation the template would be
# invisible to anyone cloning the repo, and the split it documents would never
# get adopted.
!.env.backend-secrets.example
backend/.env
frontend/.env
credentials.json
*.pem
*.key
.credentials

# Dependencies & caches
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.test-venv/
.pytest_cache/
.cache/

# Runtime data
.data/
*.db
logs/
*.log
*.pid
server.pids

# Local key material
keys.json

# Build artifacts
frontend/build/
dist/
*.egg-info/

# Generated scratch outputs
test_reports/
scratch/verification/report.md

# Agent-workspace test pollution: some e2e agent-chat tests write a stub
# src/main.py at the repo root if their workspace-root monkeypatch is bypassed
/src/

# Graphify knowledge graph — the bulky, machine-specific outputs are not tracked.
graphify-out/graph.json
graphify-out/.graphify_labels.json
# …and the signature written alongside the labels file. Ignoring the labels but
# not its .sig left the signature showing up as an untracked file every session,
# which is how it once got swept into an unrelated commit by `git add -A`.
graphify-out/.graphify_labels.json.sig
graphify-out/graph.html
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/manifest.json
graphify-out/.rebuild.lock
# NOTE: graphify-out/GRAPH_REPORT.md is deliberately COMMITTED and must stay so.
# It was listed here, which does nothing (gitignore cannot untrack a tracked
# file) but reads as an instruction to untrack it — and untracking it breaks
# three consumers that expect the committed artifact:
#   * .github/scripts/generate_context.py reads it in GitHub Actions, where the
#     graphify session hook never runs, so nothing would regenerate it;
#   * tests/test_skill_executors_live.py asserts a real read of it;
#   * services/skill_bindings.py falls back to keyword-searching it.
# Dated graphify snapshot dirs (graphify-out/2026-07-02/ etc.) — 20MB+ per run
graphify-out/20*/

# Stray "Z:/…" dir created by a session-hook path bug (Windows-style path
# treated as relative on Linux). Ignore until the hook is fixed.
Z:/

# Temporary / backup files
*.bak
*.backup
*.orig
*.tmp
*.fixed
*.new
*.log_added
*.nvidia_*
*.with_*
*.test_provider_selection

# IDE
.vscode/
.idea/
*.swp
*.swo
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Claude Code ephemeral session state — do NOT commit these
.claude/settings.local.json
.claude/sessions/
.claude/todos
render-env-vars.txt

# Fabric pattern test scratch files (prevent test leakage into the tree)
.claude/skills/fabric-patterns/patterns/tmp_*
.claude/skills/fabric-patterns/patterns/scaffold_test_*

# Instance activation (generated at runtime — never commit)
.instance_id
.activation_token
.activation_keypair.json
.onboarding_state.json
.activation_audit.jsonl

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Local credentials / memory files — never commit credentials
memory/test_credentials.md

# Ephemeral audit / triage artifacts — do not commit
bandit-report.json
gucci-audit/
triage-sweep-*.bundle
triage-sweep-*.patch
_claude_run_secret*.txt
.tmp_local_secrets/
.claude/state/sessions/
.claude/state/trend-cache.json
.claude/state/improvement-state.json

# Live SQLite mirror written by BrainConfigStore on dev runs
agency_core.db*
